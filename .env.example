# LLM gateway for the optional elicitation panel.
#
# The app works fully without this. These three variables are all that is needed,
# and they work with any OpenAI-compatible gateway: Kenari, OpenAI, Groq,
# Together, OpenRouter, DeepSeek, Mistral, Fireworks, vLLM, LM Studio, Ollama's
# /v1 mode, Azure OpenAI.
#
# Nothing in the code names a provider. See docs/llm-providers.md.

# The base URL, including the version segment, without /chat/completions.
LLM_BASE_URL=https://kenari.id/v1
LLM_API_KEY=
# Leave blank to discover from GET {LLM_BASE_URL}/models.
LLM_MODEL=

# Optional. Only sent when set, because a gateway that does not know the field
# can reject the request. Values: none | low | medium | high | max, or whatever
# your gateway documents.
# LLM_REASONING_EFFORT=low

# Optional. Extra headers as JSON, for gateways that require them.
#   Azure OpenAI:  {"api-key":"..."}   (and use the deployment name as LLM_MODEL)
#   OpenRouter:    {"HTTP-Referer":"https://your.app"}
# LLM_HEADERS=
